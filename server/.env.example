# MongoDB connection string.
# This default matches the container in ../docker-compose.yml.
DB_URL=mongodb://polyhouse:polyhouse@127.0.0.1:27017/polyhouse?authSource=admin

# Secret used to sign login tokens. Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string


# Optional shared secret for the boards. When set, both sketches must send it
# as the X-Device-Key header (DEVICE_KEY in the sketch). Leave empty to allow
# any board on the network.
DEVICE_KEY=

PORT=5000

