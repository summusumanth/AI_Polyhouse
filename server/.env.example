# Time zone the photoperiod schedules are read in. Empty = this computer's.
TIMEZONE=Asia/Kolkata

# RTSP camera gateway (MediaMTX in ../docker-compose.yml).
# MEDIAMTX_API is the control API the server registers cameras with; leave it
# empty to turn RTSP cameras off. MEDIAMTX_WEBRTC_URL is where browsers watch
# them; empty = the same host as this API, port 8889. Set it when MediaMTX is
# behind https or on another machine, e.g. https://cams.example.com
MEDIAMTX_API=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=
# Only if you turned on authentication in MediaMTX.
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=

